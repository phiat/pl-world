{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "elkjs": "npm:elkjs@^0.12.0",
    "elkjs/": "npm:/elkjs@^0.12.0/",
    "zod": "npm:zod@^4.6.5"
  },
  "tasks": {
    "validate": "deno run -A scripts/validate.ts",
    "build:db": "deno run -A scripts/build-db.ts",
    "build:layout": "deno run -A scripts/build-layout.ts",
    "prototype": "deno run -A scripts/build-db.ts && deno run -A design/prototype/build.ts",
    "runner": "deno run --allow-net=127.0.0.1 --allow-read --allow-run=docker --allow-env runner/main.ts",
    "web": "deno task --cwd web dev",
    "dev": {
      "description": "Run the sandbox runner and the web app together",
      "dependencies": [
        "runner",
        "web"
      ]
    },
    "images": "deno run --allow-read --allow-run --allow-env runner/images.ts",
    "verify": "deno run --allow-read --allow-write=data/languages --allow-run=docker --allow-env runner/verify.ts",
    "test": "deno test --allow-read --allow-run=docker --allow-env runner/"
  },
  "fmt": {
    "lineWidth": 120
  }
}
