 /// @param type The type of dialog box (see tinyfd_messageBox)
 /// @return returns the value returned by tinyfd_messageBox
 int gui_alert(const char *message, const char *title, const char *type) {
+    // pl-world: with no terminal on stdin nobody can answer the dialog, and tinyfiledialogs' console fallback would ask
+    // again on stdout forever at end of input. Report the error on stderr, minus the "Continue?" question, and stop
+    // the program with exit status 1.
+    if (!isatty(STDIN_FILENO)) {
+        std::string text(message);
+        const std::string question("\nContinue?");
+        if (text.size() >= question.size() && text.compare(text.size() - question.size(), question.size(), question) == 0)
+            text.erase(text.size() - question.size());
+        fflush(stdout);
+        fprintf(stderr, "\nRuntime error: %s\n", text.c_str());
+        fflush(stderr);
+        exit(1);
+    }
     // It is prudent to also write this to stderr.
